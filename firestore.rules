rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function tripData(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
    function isTripMember(tripId) { return signedIn() && request.auth.uid in tripData(tripId).memberUids; }
    function canEditTrip(tripId) {
      return isTripMember(tripId) &&
        (request.auth.uid == tripData(tripId).ownerUid || request.auth.uid in tripData(tripId).editorUids);
    }
    function isTripOwner(tripId) {
      return signedIn() && request.auth.uid == tripData(tripId).ownerUid;
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.editorUids.size() == 0;
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if canEditTrip(tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'start', 'end', 'updatedAt']);
      allow delete: if isTripOwner(tripId);

      match /planner/{sectionId} {
        allow read: if isTripMember(tripId);
        allow create, update, delete: if canEditTrip(tripId)
          && sectionId in ['overview', 'itinerary', 'budget', 'spa'];
      }
      match /invites/{inviteId} {
        allow read, write: if false;
      }
    }

    // Legacy owner data remains readable during the one-time migration to trips/{tripId}.
    match /users/{userId}/planner/{documentId} {
      allow read, write: if own(userId);
    }
    match /adminAccess/{userId} {
      allow read, write: if false;
    }
    match /adminTripViews/{viewId} {
      allow read, write: if false;
    }
    match /shareInvites/{inviteId} {
      allow read, write: if false;
    }
  }
}
