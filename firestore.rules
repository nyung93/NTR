rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in account can access only its own planner records.
    // Sharing trips with invited users can be added later with explicit membership rules.
    match /users/{userId}/planner/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
