rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }
    function isTripMember(tripId) {
      return signedIn() && (
        request.auth.uid == tripData(tripId).ownerUid
        || request.auth.uid in tripData(tripId).get('memberUids', [])
      );
    }
    function isTripOwner(tripId) {
      return signedIn() && request.auth.uid == tripData(tripId).ownerUid;
    }

    // Only explicitly listed Firebase Authentication UIDs can read a trip.
    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.editorUids.size() == 0;
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/trips/$(tripId))
        || request.auth.uid == resource.data.ownerUid
        || (resource.data.keys().hasAny(['memberUids']) && request.auth.uid in resource.data.memberUids)
      );
      // Keep each list branch directly provable by its matching Firestore query:
      // ownerUid == uid, or memberUids array-contains uid.
      allow list: if signedIn() && request.auth.uid == resource.data.ownerUid;
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 20
        && request.resource.data.ownerUid in request.resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'start', 'end', 'purpose', 'participants', 'memberUids', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      match /planner/{sectionId} {
        allow read: if isTripMember(tripId)
          && sectionId in ['overview', 'itinerary', 'budget', 'spa'];
        allow create, update, delete: if isTripMember(tripId)
          && (isTripOwner(tripId) || sectionId in ['itinerary', 'budget', 'spa'])
          && sectionId in ['overview', 'itinerary', 'budget', 'spa'];
      }
    }

    // Keep existing private records available for the one-time migration.
    match /users/{userId}/planner/{documentId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
