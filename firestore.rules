rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsTrip(tripId) {
      return signedIn() && request.auth.uid ==
        get(/databases/$(database)/documents/trips/$(tripId)).data.ownerUid;
    }

    // Each trip is private to the account that created it.
    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.editorUids.size() == 0;
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'start', 'end', 'updatedAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /planner/{sectionId} {
        allow read, write: if ownsTrip(tripId)
          && sectionId in ['overview', 'itinerary', 'budget', 'spa'];
      }
    }

    // Keep existing private records available for the one-time migration.
    match /users/{userId}/planner/{documentId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
